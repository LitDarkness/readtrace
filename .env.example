# Copy to your shell environment; never commit real keys.
READTRACE_ENDPOINT=https://api.openai.com/v1/chat/completions
# Prefer Base URL for school/private gateways; READTRACE_ENDPOINT remains a
# backwards-compatible full URL. Base URL normally includes the API version.
# READTRACE_BASE_URL=https://school.example/v1
# READTRACE_ENDPOINT_PATH=chat/completions
READTRACE_MODEL=gpt-4o-mini
# This value is normally the NAME of another environment variable, not the key.
READTRACE_API_KEY_ENV=READTRACE_API_KEY
READTRACE_API_KEY_REQUIRED=true
READTRACE_AUTH_HEADER=Authorization
READTRACE_AUTH_SCHEME=Bearer
READTRACE_RESPONSE_FORMAT=json_object
READTRACE_MAX_TOKENS_FIELD=max_tokens
READTRACE_CONTEXT_LIMIT=16000
# For GLM-5.2 and older, default/none sends thinking:{type:"disabled"}.
# GLM-5.3/5.3-Flash always think; default/none is mapped to reasoning_effort=low.
# Use low/high/max for GLM-5.3, and low/medium/high for other providers.
READTRACE_THINKING_MODE=default
# Runtime ledger pricing (USD per million tokens). Known OpenAI models,
# glm-5.2 and glm-5.3-flash fill these from the recorded model table. GLM-5.2
# official rates on 2026-09-02 are 1.40 input / 0.26 cached / 4.40 output.
# Leave these at 0 to use a known model's table; set all three when a school or
# custom gateway bills at different rates.
READTRACE_INPUT_PRICE=0
READTRACE_CACHED_INPUT_PRICE=0
READTRACE_OUTPUT_PRICE=0
READTRACE_PRICING_VERSION=unset
READTRACE_USD_TO_CNY=6.8
# Optional: a human-editable replacement for prompts/text_repair_system.md.
# Windows: READTRACE_CORRECTION_PROMPT_FILE=E:/path/to/my-text-repair-prompt.md
# macOS:   READTRACE_CORRECTION_PROMPT_FILE=/Users/me/path/to/my-text-repair-prompt.md
READTRACE_MAX_STEPS=8
READTRACE_TIMEOUT_SECONDS=120
# Maximum in-flight page repair calls (1..64); default 4.
READTRACE_LLM_CONCURRENCY=4
READTRACE_OCR_LANGUAGES=chi_sim+eng
READTRACE_OCR_DPI=200
READTRACE_OCR_CONCURRENCY=4
# Optional local provider registry used by the Web "来源与 API" page.
# Defaults to %LOCALAPPDATA%/ReadTrace/providers.json on Windows and
# ~/Library/Application Support/ReadTrace/providers.json on macOS. Keep it
# outside the repository so API keys can never enter Git.
# Windows: READTRACE_PROVIDER_STORE=E:/private/readtrace/providers.json
# macOS:   READTRACE_PROVIDER_STORE="/Users/me/Library/Application Support/ReadTrace/providers.json"
# Optional executable name/path for --provider codex-cli. The GUI alone is
# not a shell entry point; use codex.exe/codex.cmd/codex.ps1 from a logged-in
# Codex CLI installation. On Windows, an absolute path is most reliable.
# READTRACE_CODEX_BIN=codex
# OCR paths are loaded automatically by the CLI from the project .env.
# Prefer absolute paths (or put the tools below the project root).
# Windows:
# READTRACE_TESSERACT_BIN=E:/tools/tesseract/tesseract.exe
# READTRACE_PDFTOPPM_BIN=E:/tools/poppler/Library/bin/pdftoppm.exe
# READTRACE_PDFINFO_BIN=E:/tools/poppler/Library/bin/pdfinfo.exe
# TESSDATA_PREFIX=E:/tools/tesseract/tessdata
# macOS Apple Silicon (Intel Homebrew uses /usr/local instead):
# READTRACE_TESSERACT_BIN=/opt/homebrew/bin/tesseract
# READTRACE_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm
# READTRACE_PDFINFO_BIN=/opt/homebrew/bin/pdfinfo
# TESSDATA_PREFIX is normally unnecessary on macOS. If chi_sim is not found:
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# For the GLM preset, set GLM_API_KEY in .env or your shell. Never commit it.
# For the Codex Luna preset, use an endpoint that actually exposes this model:
# READTRACE_MODEL=gpt-5.6-luna
# READTRACE_THINKING_MODE=high
# READTRACE_MAX_TOKENS_FIELD=max_completion_tokens
# READTRACE_API_KEY_ENV=OPENAI_API_KEY
